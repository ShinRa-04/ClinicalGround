P01 -> P07 [label="S-P07 request", tooltip="A complaint about service and an appeal of a coverage decision are separate routes; a job title does not establish appointment."];
P07 -> P01 [label="S-P07 response", tooltip="A complaint about service and an appeal of a coverage decision are separate routes; a job title does not establish appointment."];
P01 -> C01 [label="S-C01 request", tooltip="License, privileges and clinical setting control the activity; this is not a hierarchy over insurer employees."];
C01 -> P01 [label="S-C01 response", tooltip="License, privileges and clinical setting control the activity; this is not a hierarchy over insurer employees."];
P01 -> C02 [label="S-C02 request", tooltip="May be a physician, NP or PA under the relevant professional rules; this is a functional role, not an additional credential."];
C02 -> P01 [label="S-C02 response", tooltip="May be a physician, NP or PA under the relevant professional rules; this is a functional role, not an additional credential."];
C02 -> C03 [label="S-C03 request", tooltip="Clinical responsibility must be assigned for the actual service; specialist is not necessarily the organizational supervisor of the PCP."];
C03 -> C02 [label="S-C03 response", tooltip="Clinical responsibility must be assigned for the actual service; specialist is not necessarily the organizational supervisor of the PCP."];
P01 -> C04 [label="S-C04 request", tooltip="Specify state, population focus, privileges and any required practice arrangement before concluding independent authority. California examples separate practice category, furnishing authority and employer requirements. Prospective 104-availability wording is not proof of present individual certification or application availability."];
C04 -> P01 [label="S-C04 response", tooltip="Specify state, population focus, privileges and any required practice arrangement before concluding independent authority. California examples separate practice category, furnishing authority and employer requirements. Prospective 104-availability wording is not proof of present individual certification or application availability."];
P01 -> C05 [label="S-C05 request", tooltip="PA means physician assistant in this profile; prior authorization is written out to avoid acronym confusion."];
C05 -> P01 [label="S-C05 response", tooltip="PA means physician assistant in this profile; prior authorization is written out to avoid acronym confusion."];
C01 -> C06 [label="S-C06 request", tooltip="A direct-care RN, payer UM nurse and nurse case manager are different functions even if one person can hold more than one role."];
C06 -> C01 [label="S-C06 response", tooltip="A direct-care RN, payer UM nurse and nurse case manager are different functions even if one person can hold more than one role."];
C06 -> C07 [label="S-C07 request", tooltip="State law and setting determine supervision and permitted activities; staffing title alone is insufficient."];
C07 -> C06 [label="S-C07 response", tooltip="State law and setting determine supervision and permitted activities; staffing title alone is insufficient."];
C01 -> C08 [label="S-C08 request", tooltip="Specific clinical tasks depend on state rules and training; this role is not interchangeable with a physician assistant."];
C08 -> C01 [label="S-C08 response", tooltip="Specific clinical tasks depend on state rules and training; this role is not interchangeable with a physician assistant."];
C01 -> O01 [label="S-O01 request", tooltip="Works for requester; not payer intake. Local payer requirements and request stage determine the needed packet."];
O01 -> C01 [label="S-O01 response", tooltip="Works for requester; not payer intake. Local payer requirements and request stage determine the needed packet."];
C02 -> O02 [label="S-O02 request", tooltip="May share a job with scheduling or authorization; preserve those functions as separate milestones."];
O02 -> C02 [label="S-O02 response", tooltip="May share a job with scheduling or authorization; preserve those functions as separate milestones."];
P01 -> O03 [label="S-O03 request", tooltip="Identity, benefits verification and authorization are distinct checks even if performed by the same employee."];
O03 -> P01 [label="S-O03 response", tooltip="Identity, benefits verification and authorization are distinct checks even if performed by the same employee."];
O03 -> O04 [label="S-O04 request", tooltip="Uses plan-specific information; a coverage estimate is not final claim adjudication."];
O04 -> O03 [label="S-O04 response", tooltip="Uses plan-specific information; a coverage estimate is not final claim adjudication."];
O02 -> O05 [label="S-O05 request", tooltip="Scheduling may occur before authorization, but completion/readiness must not be inferred from booking alone."];
O05 -> O02 [label="S-O05 response", tooltip="Scheduling may occur before authorization, but completion/readiness must not be inferred from booking alone."];
O01 -> O06 [label="S-O06 request", tooltip="Purpose matters: HIPAA minimum-necessary exceptions include specified treatment disclosures; other privacy requirements can still apply."];
O06 -> O01 [label="S-O06 response", tooltip="Purpose matters: HIPAA minimum-necessary exceptions include specified treatment disclosures; other privacy requirements can still apply."];
