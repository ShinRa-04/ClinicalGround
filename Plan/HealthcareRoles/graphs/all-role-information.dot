O13 -> C01 [label="S-O13 response", tooltip="This is an evidence-supply function spanning distinct professions, not a claim that laboratory staff, radiologists and therapists have identical permissions."];
O01 -> U01 [label="S-U01 request", tooltip="Different employer/function from provider authorization specialist; decisions follow the actual plan/delegation. R13 describes some limited nonclinical approvals and assigned benefit-only decisions; it is not a national permission or medical-necessity-denial grant."];
U01 -> O01 [label="S-U01 response", tooltip="Different employer/function from provider authorization specialist; decisions follow the actual plan/delegation. R13 describes some limited nonclinical approvals and assigned benefit-only decisions; it is not a national permission or medical-necessity-denial grant."];
U01 -> U02 [label="S-U02 request", tooltip="Exact benefit authority and decision notice are plan-specific; not every benefits specialist is authorized to issue a denial. R13 permits some assigned benefit-only decisions; actual signatory authority still requires the plan/delegation."];
U02 -> U01 [label="S-U02 response", tooltip="Exact benefit authority and decision notice are plan-specific; not every benefits specialist is authorized to issue a denial. R13 permits some assigned benefit-only decisions; actual signatory authority still requires the plan/delegation."];
U01 -> U03 [label="S-U03 request", tooltip="Under MA 422.566(d), anticipated adverse medical necessity requires appropriate licensed professional review; local policy may impose stricter physician escalation. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U03 -> U01 [label="S-U03 response", tooltip="Under MA 422.566(d), anticipated adverse medical necessity requires appropriate licensed professional review; local policy may impose stricter physician escalation. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U03 -> U04 [label="S-U04 request", tooltip="Case-review function is distinct from organization-wide CMO governance; authority depends on product, license, expertise and delegation. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U04 -> U03 [label="S-U04 response", tooltip="Case-review function is distinct from organization-wide CMO governance; authority depends on product, license, expertise and delegation. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U04 -> U05 [label="S-U05 request", tooltip="Differentiate contracted expertise, internal consultation and statutory independent review."];
U05 -> U04 [label="S-U05 response", tooltip="Differentiate contracted expertise, internal consultation and statutory independent review."];
U01 -> U06 [label="S-U06 request", tooltip="Psychiatrist, psychologist and counselor credentials are not interchangeable; apply actual product and review requirements. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U06 -> U01 [label="S-U06 response", tooltip="Psychiatrist, psychologist and counselor credentials are not interchangeable; apply actual product and review requirements. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U01 -> U07 [label="S-U07 request", tooltip="Medication pathways can differ from medical-service prior authorization and Part C item/service appeals. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U07 -> U01 [label="S-U07 response", tooltip="Medication pathways can differ from medical-service prior authorization and Part C item/service appeals. R13 has both a wider professional-category list and medical-director final-responsibility language. Specific case review/signoff must be clarified, not inferred from either statement alone."];
U01 -> U08 [label="S-U08 request", tooltip="Functional wrapper, not an extra profession; identify both employer and actual licensed/intake role. In R13, AZPC explicitly retains no delegation to process, decide or notify appeals; the plan handles that review."];
U08 -> U01 [label="S-U08 response", tooltip="Functional wrapper, not an extra profession; identify both employer and actual licensed/intake role. In R13, AZPC explicitly retains no delegation to process, decide or notify appeals; the plan handles that review."];
