O07 -> G15 [label="S-O07 response", tooltip="Authorization and claims can involve different code requirements; this role is conditional, not mandatory on every case."];
O07 -> O08 [label="S-O08 request", tooltip="Documentation improvement is not permission to rewrite clinical facts to match coverage criteria."];
O08 -> O07 [label="S-O08 response", tooltip="Documentation improvement is not permission to rewrite clinical facts to match coverage criteria."];
P01 -> O09 [label="S-O09 request", tooltip="Estimates, assistance approvals, authorization and final claims are separate records and decisions."];
O09 -> P01 [label="S-O09 response", tooltip="Estimates, assistance approvals, authorization and final claims are separate records and decisions."];
O01 -> O10 [label="S-O10 request", tooltip="Separate pre-service authorization disputes from post-service claim denials; actual notice determines route and deadlines."];
O10 -> O01 [label="S-O10 response", tooltip="Separate pre-service authorization disputes from post-service claim denials; actual notice determines route and deadlines."];
O10 -> O11 [label="S-O11 request", tooltip="May be the treating physician rather than a separate employee; duties depend on relationship to the patient and organization."];
O11 -> O10 [label="S-O11 response", tooltip="May be the treating physician rather than a separate employee; duties depend on relationship to the patient and organization."];
O01 -> O12 [label="S-O12 request", tooltip="Specific reporting lines are organization-specific and are not inferred from a generic title."];
O12 -> O01 [label="S-O12 response", tooltip="Specific reporting lines are organization-specific and are not inferred from a generic title."];
