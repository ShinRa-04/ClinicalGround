# Copy to Runner/.env and fill only the providers you use. Never commit .env.
# The official judge always requires this key for scored trials.
ANTHROPIC_API_KEY=

# Agent provider credentials (set whichever your selected agent needs).
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Hugging Face login is kept separately in Runner/.cache/huggingface/.
# Run .\Runner\toolkit.ps1 hf auth login after handbook approval.
